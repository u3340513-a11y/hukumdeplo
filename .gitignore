# ─────────────────────────────────────────────
# Ortam ve Gizli Dosyalar (repoya girmesin)
# ─────────────────────────────────────────────
core/.env
core/.env.backup
core/.env.local
core/.env.*.local

# NOT: core/vendor/ KASITLI OLARAK dahil edildi.
# cPanel'de terminal erişimi olmadığından composer çalıştırılamaz.

# ─────────────────────────────────────────────
# Laravel Önbellek ve Geçici Dosyalar
# ─────────────────────────────────────────────
core/bootstrap/cache/*.php
core/storage/framework/cache/data/*
core/storage/framework/sessions/*
core/storage/framework/views/*
core/storage/logs/*

# storage alt klasörleri .gitkeep dahil
!core/storage/framework/cache/data/.gitkeep
!core/storage/framework/sessions/.gitkeep
!core/storage/framework/views/.gitkeep
!core/storage/logs/.gitkeep
!core/bootstrap/cache/.gitkeep

# ─────────────────────────────────────────────
# Derleme Çıktıları (build/ cPanel'de önceden derlenmiş olarak tutuluyor)
# ─────────────────────────────────────────────
core/node_modules/
core/public/hot
core/public/storage

# ─────────────────────────────────────────────
# macOS / IDE
# ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
